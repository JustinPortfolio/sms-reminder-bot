{
  "name": "sms-reminder-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Twilio-based appointment reminder bot with inbound reply handling (confirm/cancel/reschedule/stop).",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "send-reminders": "tsx src/sendReminders.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "twilio": "^5.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.1"
  }
}

